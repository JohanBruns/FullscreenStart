<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette (Windows "light" mode). Same keys as Colors.Dark.xaml. -->
    <SolidColorBrush x:Key="TintBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#99000000" />
    <SolidColorBrush x:Key="TileBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="TileHoverBorderBrush" Color="#33000000" />
    <SolidColorBrush x:Key="DrawerBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#24000000" />
    <SolidColorBrush x:Key="SidebarExpandedBrush" Color="#F2F3F3F3" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F7F9F9F9" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#80000000" />
    <SolidColorBrush x:Key="LetterIndexBrush" Color="#E6F3F3F3" />
    <SolidColorBrush x:Key="DropTargetFillBrush" Color="#1A000000" />
</ResourceDictionary>
