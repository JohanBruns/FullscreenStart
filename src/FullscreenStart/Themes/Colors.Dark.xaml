<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Referenced with DynamicResource so the theme can switch at runtime. -->
    <SolidColorBrush x:Key="TintBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TileBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#45FFFFFF" />
    <SolidColorBrush x:Key="TileHoverBorderBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="DrawerBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SidebarExpandedBrush" Color="#F21F1F1F" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F72B2B2B" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="LetterIndexBrush" Color="#E61C1C1C" />
    <SolidColorBrush x:Key="DropTargetFillBrush" Color="#22FFFFFF" />
</ResourceDictionary>
