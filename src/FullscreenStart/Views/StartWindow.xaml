<Window x:Class="FullscreenStart.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FullscreenStart.ViewModels"
        xmlns:v="clr-namespace:FullscreenStart.Views"
        xmlns:m="clr-namespace:FullscreenStart.Models"
        Title="Start"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="#1C1C1C"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ===== Tile ===== -->
        <DataTemplate DataType="{x:Type vm:TileViewModel}">
            <Border x:Name="TileRoot" Tag="tile" Background="{StaticResource TileBrush}" BorderThickness="1"
                    BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5"
                    ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="600">
                <Grid ClipToBounds="True">
                    <Image x:Name="Icon" Source="{Binding App.LargeIcon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IsApp, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="MissingGlyph" Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PreviewItems}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0,0,0,8" IsHitTestVisible="False"
                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding PreviewColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding App.Icon}" Margin="3"
                                       Width="{Binding DataContext.PreviewIconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       Height="{Binding DataContext.PreviewIconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="8,0,8,6" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="TileRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TileRoot" Property="Background" Value="{StaticResource TileHoverBrush}" />
                    <Setter TargetName="TileRoot" Property="BorderBrush" Value="{StaticResource TileHoverBorderBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="TileRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="TileRoot" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="TileRoot" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowLabel}" Value="True">
                    <Setter TargetName="Icon" Property="Margin" Value="0,0,0,6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Open folder ===== -->
        <DataTemplate DataType="{x:Type vm:FolderDrawerViewModel}">
            <Border Tag="drawer" Background="{StaticResource DrawerBrush}">
                <StackPanel>
                    <TextBox x:Name="FolderName" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PlainTextBox}"
                             Background="Transparent" BorderThickness="0" FontSize="15" Height="36" Margin="2,2,2,2" Padding="6,0"
                             KeyDown="FolderName_KeyDown" />
                    <ItemsControl ItemsSource="{Binding Children}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <v:TileGroupPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== Group ===== -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:GroupViewModel}">
            <StackPanel Tag="group" Margin="0,0,0,18" Background="Transparent">
                <Grid x:Name="Header" Tag="groupheader" Height="44" Background="Transparent">
                    <TextBlock x:Name="HeaderText" Text="{Binding Name}" FontSize="15" VerticalAlignment="Bottom"
                               Margin="0,0,32,11" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Placeholder" Text="Gruppe benennen" FontSize="15" VerticalAlignment="Bottom"
                               Margin="0,0,32,11" Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="Grip" Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,12"
                               Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
                    <TextBox x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PlainTextBox}" BorderThickness="0,0,0,2" FontSize="15" Height="32"
                             VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="Collapsed"
                             KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <v:TileGroupPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Header}" Value="True" />
                        <Condition Binding="{Binding HasName}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="HeaderText" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Grip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== App list row (All apps, search) ===== -->
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type m:AppEntry}">
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="290" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseRightButtonUp="Root_MouseRightButtonUp">

        <!-- Backdrop: blurred wallpaper + tint + subtle noise (acrylic look) -->
        <Image x:Name="BackdropImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
        <Rectangle x:Name="BackdropTint" Fill="{StaticResource TintBrush}" />
        <Rectangle x:Name="BackdropNoise" Opacity="0.035" />

        <Grid x:Name="Chrome">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ContentRoot" Grid.Column="1">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>

                <!-- Pinned tiles -->
                <ScrollViewer x:Name="PinnedScroll" Focusable="False" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" PanningMode="Both"
                              Visibility="{Binding ShowPinned, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel x:Name="ColumnsHost" Orientation="Horizontal" Margin="38,0,0,0">
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColumnViewModel}">
                                    <Border Tag="column" Background="Transparent" Margin="0,0,76,0"
                                            MinHeight="{Binding ViewportHeight, ElementName=PinnedScroll}">
                                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}"
                                                      VerticalAlignment="Top" Margin="0,58,0,24" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="NewColumnTarget" Tag="newcolumn" Width="380" Margin="0,0,76,0"
                                Background="Transparent" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- All apps -->
                <Grid x:Name="AllAppsPane" Visibility="{Binding ShowAllApps, Converter={StaticResource BoolToVisibility}}">
                    <ListBox x:Name="AllAppsList" ItemsSource="{Binding AllAppsView}" ItemTemplate="{StaticResource AppRowTemplate}"
                             IsSynchronizedWithCurrentItem="False"
                             ItemContainerStyle="{StaticResource AppListItem}" Width="380" HorizontalAlignment="Left"
                             Margin="30,16,0,0" Background="Transparent" BorderThickness="0" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonUp="AppList_PreviewMouseLeftButtonUp">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Style="{StaticResource LetterButton}" FontSize="15"
                                                HorizontalAlignment="Left" HorizontalContentAlignment="Left" Width="44" Height="40"
                                                Margin="2,6,0,0" Click="LetterHeader_Click" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- Letter index (opens from a group header) -->
                    <Border x:Name="LetterIndex" Width="380" HorizontalAlignment="Left" Margin="30,16,0,0"
                            Background="#E61C1C1C" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding Letters}" VerticalAlignment="Top" Margin="0,40,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LetterItem}">
                                    <Button Content="{Binding Letter}" IsEnabled="{Binding HasApps}" Height="76"
                                            Style="{StaticResource LetterButton}" Click="LetterIndex_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>

                <!-- Search -->
                <Grid x:Name="SearchPane" Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Width="520" HorizontalAlignment="Left" Margin="38,30,0,0">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlainTextBox}" BorderThickness="0,0,0,2" FontSize="20" Height="48"
                                 Padding="40,0,8,0" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="14,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Keine Treffer" Margin="46,24,0,0" FontSize="14"
                               Foreground="{StaticResource SubtleTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="SearchList" Grid.Row="2" ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedResult}" ItemTemplate="{StaticResource AppRowTemplate}"
                             ItemContainerStyle="{StaticResource AppListItem}" Width="520" HorizontalAlignment="Left"
                             Margin="38,12,0,0" Background="Transparent" BorderThickness="0" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="AppList_PreviewMouseLeftButtonUp" />
                </Grid>
            </Grid>

            <!-- Sidebar (expands over the content) -->
            <Border x:Name="Sidebar" Grid.ColumnSpan="2" Width="48" HorizontalAlignment="Left" ClipToBounds="True"
                    Background="Transparent">
                <DockPanel LastChildFill="False" Width="280" HorizontalAlignment="Left">
                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                        <Button x:Name="HamburgerButton" Style="{StaticResource NavButton}" Click="Hamburger_Click" ToolTip="Erweitern">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="48" TextAlignment="Center" />
                                <TextBlock Text="START" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PinnedButton" Style="{StaticResource NavButton}" Click="PinnedView_Click" ToolTip="Angeheftet">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xECA5;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="48" TextAlignment="Center" />
                                <TextBlock Text="Angeheftet" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AllAppsButton" Style="{StaticResource NavButton}" Click="AllAppsView_Click" ToolTip="Alle Apps">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="48" TextAlignment="Center" />
                                <TextBlock Text="Alle Apps" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                        <Button x:Name="UserButton" Style="{StaticResource NavButton}" Click="User_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="48">
                                    <Ellipse x:Name="UserPicture" Width="26" Height="26" Visibility="Collapsed" />
                                    <TextBlock x:Name="UserGlyph" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="UserNameText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Documents_Click" ToolTip="Dokumente">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="48" TextAlignment="Center" />
                                <TextBlock Text="Dokumente" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Pictures_Click" ToolTip="Bilder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="48" TextAlignment="Center" />
                                <TextBlock Text="Bilder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Settings_Click" ToolTip="Einstellungen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="48" TextAlignment="Center" />
                                <TextBlock Text="Einstellungen" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PowerButton" Style="{StaticResource NavButton}" Click="Power_Click" ToolTip="Ein/Aus">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="48" TextAlignment="Center" />
                                <TextBlock Text="Ein/Aus" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Drag & drop feedback (never hit-testable) -->
        <Canvas x:Name="DragLayer" IsHitTestVisible="False" />
    </Grid>
</Window>
